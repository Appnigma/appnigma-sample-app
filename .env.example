# Copy to .env and fill in your SDK key.

PORT=4700
# Where your users reach this app: http://localhost:4701 with npm run dev,
# http://localhost:4700 with npm start. Connecting a platform sends them back here.
PUBLIC_URL=http://localhost:4701
# Appnigma only sends people back to an https address. On your own machine,
# set an https page that forwards them on to PUBLIC_URL, or put a tunnel (for
# example ngrok) in front of the app and use its https address as PUBLIC_URL.
RETURN_PAGE_URL=

# Your SDK key. Appnigma gives it to you when your microserver is set up. It
# starts with apn_live_. Keep it on the server only: never in the browser.
APPNIGMA_SDK_KEY=

# The secret Admin → Webhooks and alerts shows once, when you add this app's
# webhook. With it here, the receiver checks signatures after a restart too.
APPNIGMA_WEBHOOK_SECRET=

# Your product's name and colour.
PRODUCT_NAME=Acme Desk
BRAND_COLOR=#4f46e5
